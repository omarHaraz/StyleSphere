{
  "name": "clothify-admin",
  "version": "1.0.0",
  "description": "Clothify Admin Dashboard - Clothing store administration",
  "main": "/dashboard.html",
  "type": "module",
  "directories": {
    "example": "root"
  },
  "scripts": {
    "open-app": "gulp open-app",
    "start": "npm run open-app",
